<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <Label layoutX="232.0" layoutY="61.0" text="Operações das caixinhas" />
      <ComboBox fx:id="cbSelectCaixinha" layoutX="221.0" layoutY="106.0" prefHeight="26.0" prefWidth="152.0" promptText="Selecione a caixinha" />
      <Label fx:id="lblSaldoAtual" layoutX="221.0" layoutY="160.0" text="Saldo atual:" />
      <TextField fx:id="tfValorDeposito" layoutX="222.0" layoutY="187.0" promptText="Valor de depósito" />
      <Button fx:id="btDepositar" layoutX="378.0" layoutY="187.0" mnemonicParsing="false" onAction="#onDepositar" text="Depositar" />
      <Button fx:id="tfRetirar" layoutX="377.0" layoutY="227.0" mnemonicParsing="false" onAction="#onRetirar" prefHeight="26.0" prefWidth="67.0" text="Retirar" />
      <TextField fx:id="tfValorRetirada" layoutX="222.0" layoutY="227.0" promptText="Valor de retirada" />
   </children>
</AnchorPane>
