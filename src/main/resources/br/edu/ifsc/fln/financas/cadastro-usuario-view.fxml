<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="10.0" prefHeight="500.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.edu.ifsc.fln.financas.controller.CadastroUsuarioController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <children>
        <Label text="Cadastro de usuario" />
        <TextField fx:id="tfNome" promptText="Nome" maxWidth="300" />
        <TextField fx:id="tfCpf" promptText="CPF" maxWidth="300" />
        <Label text="Adicione todas as rendas fixas que possui." />
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <TextField fx:id="tfRenda" promptText="Valor da renda fixa" maxWidth="200" />
                <Button fx:id="btAdicionarRenda" text="Adicionar renda" onAction="#onAdicionarRenda" />
            </children>
        </HBox>
        <ListView fx:id="lvRendas" maxWidth="300" prefHeight="150" />
        <Label fx:id="lblTotal" text="Total das rendas: R$ 0.0" />
        <Button fx:id="btCadastrar" text="Concluir cadastro" onAction="#onCadastrar" />
    </children>
</VBox>