<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="433.0" prefWidth="641.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.ifsc.fln.financas.controller.DashboardController">

   <Label layoutX="271.0" layoutY="24.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Painel do mês" />

   <Label fx:id="lblRendaTotal" layoutX="26.0" layoutY="94.0" text="Renda total:" />
   <Label fx:id="lblTotalGasto" layoutX="178.0" layoutY="94.0" text="Total gasto:" />

   <Label fx:id="lbValorNecessidades" layoutX="30.0" layoutY="140.0" text="Necessidades:" />
   <ProgressBar fx:id="pbNecessidades" layoutX="30.0" layoutY="163.0" prefWidth="280.0" progress="0.0" />

   <Label fx:id="lbValorDesejos" layoutX="30.0" layoutY="200.0" text="Desejos:" />
   <ProgressBar fx:id="pbDesejos" layoutX="30.0" layoutY="223.0" prefWidth="280.0" progress="0.0" />

   <Label fx:id="lbValorEconomias" layoutX="30.0" layoutY="260.0" text="Economia:" />
   <ProgressBar fx:id="pbEconomia" layoutX="30.0" layoutY="283.0" prefWidth="280.0" progress="0.0" />

   <PieChart fx:id="pizza50" layoutX="330.0" layoutY="130.0" prefHeight="260.0" prefWidth="290.0" style="-fx-background-color: #EAF2EE;" />

   <Button layoutX="52.0" layoutY="334.0" onAction="#onLancarDespesa" text="Lançar despesa" />
   <Button layoutX="170.0" layoutY="334.0" onAction="#onAdicionarReceita" text="Adicionar receita" />
   <Button layoutX="27.0" layoutY="25.0" onAction="#onVoltar" text="Voltar home" />

</AnchorPane>
